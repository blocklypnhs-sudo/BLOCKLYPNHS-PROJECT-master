# Copy this file to ".env" (same folder as app.py) and fill in your values.
# Never share or upload the real .env file. Add ".env" to .gitignore.

# ---- Resend (https://resend.com) ----
# Dashboard > API Keys > Create API Key. The key starts with "re_".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address.
# TESTING (no domain needed): leave as onboarding@resend.dev. Resend will then
#   deliver emails ONLY to the email you signed up to Resend with, so you can
#   test with your own address, but real students will not receive anything.
# REAL USE: verify a domain you own at https://resend.com/domains, then use
#   an address on it, e.g. BlockLearn <noreply@yourdomain.com>
MAIL_FROM=onboarding@resend.dev

# Address students use to open the site. Used for the links inside emails.
# Example: http://192.168.1.10:5000
APP_BASE_URL=http://127.0.0.1:5000

# ---- Optional: plain SMTP instead (only used if RESEND_API_KEY is empty) ----
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your.school.email@gmail.com
# MAIL_PASSWORD=your-16-letter-app-password
