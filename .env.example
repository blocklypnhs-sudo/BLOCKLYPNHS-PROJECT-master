# Copy this file to .env. The supplied EmailJS identifiers/public key are set below.
# Keep .env private. EMAILJS_PRIVATE_KEY is optional and must never go in frontend code.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
EMAILJS_SERVICE_ID=service_e05jqek
EMAILJS_TEMPLATE_ID=template_nzzct3h
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=template_ppv3z3j
EMAILJS_PUBLIC_KEY=Tv1CWo9ZfTs2T7jyz
EMAILJS_PRIVATE_KEY=

# Configure the EmailJS template with these template variables:
# email, name, passcode, time
# Set "To Email" to {{email}} (not a fixed mailbox), "From Name" to {{name}},
# "Reply To" to {{email}}, and place {{passcode}} and {{time}} in the email body.
# The OTP expires after 10 minutes, so make the template say 10 minutes, not 15.
#
# Password reset template variables: email, name, link.
# Set its "To Email" to {{email}}, "From Name" to {{name}}, "Reply To" to {{email}},
# and include {{link}} in the reset button/link content. The reset link expires in one hour.
